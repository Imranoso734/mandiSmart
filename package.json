{
  "name": "mandismart-api",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "start:dev": "tsc-watch --onSuccess \"dotenv -e .env -- node build/index.js\"",
    "build": "npx tsc",
    "start:local": "dotenv -e .env -- node build/index.js",
    "start:prod": "npx pm2 start --no-daemon",
    "gen:secret": "node ./src/core/scripts/generateSecret.mjs",
    "gen:types": "npx prisma generate",
    "test": "dotenv -e .env -- npx vitest --threads false",
    "lint": "npx eslint ./src/ --ext .ts",
    "fmt": "npx prettier --write ./src/",
    "check": "npm run lint && npm run fmt",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "npx prisma db seed",
    "db:reset": "npx prisma migrate reset --force",
    "db:setup": "npx prisma migrate dev --name init && npx prisma db seed",
    "docker:db": "docker compose up -d db"
  },
  "_moduleAliases": {
    "@": "build"
  },
  "eslintConfig": {
    "root": true,
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended"
    ],
    "rules": {
      "no-console": "error",
      "quotes": [
        2,
        "double",
        {
          "allowTemplateLiterals": true,
          "avoidEscape": true
        }
      ],
      "semi": [
        "error",
        "never"
      ]
    }
  },
  "prettier": {
    "singleQuote": false,
    "semi": false,
    "tabWidth": 2,
    "trailingComma": "all"
  },
  "prisma": {
    "seed": "node src/app/seeders.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "prisma": "^6.19.2",
    "tsc-watch": "^6.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/error": "^3.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/request-context": "^6.2.1",
    "@fastify/static": "^9.0.0",
    "@prisma/client": "^6.19.2",
    "argon2": "^0.41.1",
    "dotenv-cli": "^7.0.0",
    "fastify": "^5.7.4",
    "json-schema-to-ts": "^3.1.1",
    "module-alias": "^2.2.3",
    "njwt": "^2.0.0",
    "owasp-password-strength-test": "^1.3.0",
    "pino": "^9.0.0",
    "pm2": "^5.4.0"
  }
}
